# ──────────────────────────────────────────────
# Codebase Knowledge Extractor — Configuration
# Copy to .env and fill in your values
# ──────────────────────────────────────────────

# ── LLM ──────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here
LLM_MODEL=claude-sonnet-4-20250514
LLM_TEMPERATURE=0.0
LLM_MAX_OUTPUT_TOKENS=4096

# ── Token budget ─────────────────────────────
MAX_TOKENS_PER_CHUNK=12000
CHARS_PER_TOKEN=3.5

# ── Repository ───────────────────────────────
REPO_PATH=./spring-rest-sakila_tvr
# GIT_TOKEN=ghp_xxxx        # GitHub PAT for private repos (optional)
INCLUDE_TESTS=false

# ── Output ───────────────────────────────────
OUTPUT_PATH=output/knowledge.json
CACHE_PATH=output/llm_cache.json
